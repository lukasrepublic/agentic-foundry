# USER-scope environment for native Claude Code usage export (gn-05).
# Put these in YOUR user settings (~/.claude/settings.json -> "env": {...}) or your shell profile.
# Project-scope settings IGNORE OTEL keys (Claude Code >= 2.1.282), so a committed .claude/settings.json
# cannot carry this; the updater must not try either.
# Numeric usage + correlation metadata only: do NOT set OTEL_LOG_USER_PROMPTS / OTEL_LOG_TOOL_DETAILS.
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# The collector (context/otelcol-usage.yaml) listens here; or the shared private endpoint the operator names.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Your operator id, as in .claude/foundry-operators.json: the consuming operator stays on every record.
OTEL_RESOURCE_ATTRIBUTES=foundry.operator=<op_id>
