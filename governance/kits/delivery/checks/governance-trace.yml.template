# governance-trace — the job template the delivery kit ships (gv-16, design §5.4).
#
# Copy this job into the adopter's CI workflow (the intake `apply` step does it from the kit). It runs on `pull_request`
# with a READ-ONLY token. It checks the PR head out only to READ it, and runs the check from the PLUGIN checkout pinned at
# the locked version, never from a script the PR could have rewritten. Every `uses:` is pinned to a 40-character commit
# SHA; replace <PLUGIN_REF> with the 40-character commit of the plugin version in `.foundry/governance.lock`.
#
# Add the job's name (`governance-trace`) to the base branch's required status checks to make it a gate.
name: governance-trace

on:
  pull_request:
    types: [opened, synchronize, reopened, edited]

permissions:
  contents: read
  pull-requests: read
  issues: read

jobs:
  governance-trace:
    runs-on: ubuntu-24.04
    steps:
      - name: Check out the PR head (read only)
        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
        with:
          path: pr
          persist-credentials: false
      - name: Check out the plugin at the locked version
        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
        with:
          repository: lukasrepublic/agentic-foundry
          ref: <PLUGIN_REF>
          path: plugin
          persist-credentials: false
      - name: Read the PR and its ticket
        env:
          GH_TOKEN: ${{ github.token }}
          PR: ${{ github.event.pull_request.number }}
          REPO: ${{ github.repository }}
        run: |
          set -euo pipefail
          gh pr view "$PR" --repo "$REPO" --json number,body,files > pr.json
          N="$(python3 plugin/governance/kits/delivery/checks/governance-trace.py ticket-ref --pr-json pr.json)"
          gh issue view "$N" --repo "$REPO" --json number,body,labels > ticket.json
      - name: governance-trace
        env:
          CLAUDE_PLUGIN_ROOT: ${{ github.workspace }}/plugin
        run: python3 plugin/governance/kits/delivery/checks/governance-trace.py check --pr-json pr.json --ticket-json ticket.json --project-dir pr
