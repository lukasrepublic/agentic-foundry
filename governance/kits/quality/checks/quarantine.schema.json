{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flaky-test quarantine record list",
  "type": "object",
  "required": ["quarantine"],
  "additionalProperties": false,
  "properties": {
    "quarantine": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test", "owner", "issue", "entry", "expiry"],
        "additionalProperties": false,
        "properties": {
          "test": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "issue": {"type": "string", "minLength": 1},
          "entry": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "expiry": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "retry_budget": {"type": "integer", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
