# Enforces FG-SEC-024. Copy this file into .github/workflows/ and rename it to .yml.
# Copy checks/gitleaks.toml to the repo root as .gitleaks.toml (the action picks it up), or keep GITLEAKS_CONFIG below.
# On organization repositories the action also needs a GITLEAKS_LICENSE secret.
name: secret-scan
on: [pull_request]
permissions:
  contents: read
jobs:
  gitleaks:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: gitleaks/gitleaks-action@ff98106e4c7b2bc287b24eaf42907196329070c7 # v2.3.9
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITLEAKS_CONFIG: security-checks/gitleaks.toml
          # GITLEAKS_LICENSE: ${{ secrets.GITLEAKS_LICENSE }}  # required for organization repositories
