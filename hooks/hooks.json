{
  "//": "Foundry hook wiring (ticket-first, v2.0.0). Hooks are ADDITIVE with the consuming repo's .claude/hooks (both fire; dedup by command string). All commands resolve sibling scripts via ${CLAUDE_PLUGIN_ROOT} and are direct-invoked (exec-bit + shebang); scripts/foundry-doctor.py's check_hooks resolves a command's SCRIPT as its first whitespace token, so no interpreter prefix is used. The doctor's check_hooks fails when a wired script is missing or not executable. Wired: PreToolUse Bash (git-discipline, shell-shape, secret-read-guard, plugin-scripts-allow: a refusal from any earlier hook stands), PreToolUse Edit|Write (cwd-enforce, paper-guard), SessionStart (doctor --heal / --session-start, compact-reinject), Stop (ticket-stop), SessionEnd (env-reap), SubagentStop (env-reap --subagent-stop: gv-12 adds that mode to hooks/foundry-env-reap.sh; MERGE gv-12 FIRST: before it lands the script ignores the argument and runs its full SessionEnd reap), WorktreeCreate/Remove, SubagentStart (usage-bind, fail-open). There is no merge-gate hook, no learnings capture, and no task/teammate hook.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-git-discipline.sh --protected main"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-shell-shape.py"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-secret-read-guard.py"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-plugin-scripts-allow.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-cwd-enforce.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-paper-guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/foundry-doctor.py --heal"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/foundry-doctor.py --session-start"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-compact-reinject.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-ticket-stop.py",
            "timeout": 330
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-env-reap.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-worktree-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-worktree-remove.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-env-reap.sh --subagent-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/foundry-usage-bind.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
