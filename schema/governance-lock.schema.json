{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lukasrepublic/agentic-foundry/schema/governance-lock.schema.json",
  "title": "Governance lock (.foundry/governance.lock) - machine-owned",
  "type": "object",
  "required": ["blueprint", "kits", "declarations", "facts_sha256", "intake_at", "plugin_version"],
  "additionalProperties": false,
  "properties": {
    "blueprint": {
      "type": "object",
      "required": ["id", "version", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "version": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "kits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "sha256", "level"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "version": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "level": {"type": "integer", "minimum": 1, "maximum": 3}
        }
      }
    },
    "declarations": {
      "type": "object",
      "required": ["asvs_level", "data_classification", "trust_boundaries", "surfaces"],
      "additionalProperties": false,
      "properties": {
        "asvs_level": {"type": "integer", "minimum": 1, "maximum": 3},
        "data_classification": {"type": "array", "items": {"type": "string"}},
        "trust_boundaries": {"type": "array", "items": {"type": "string"}},
        "surfaces": {"type": "array", "items": {"type": "string"}}
      }
    },
    "facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "intake_at": {"type": "string"},
    "plugin_version": {"type": "string"}
  }
}
