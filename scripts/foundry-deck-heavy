#!/usr/bin/env python3
"""foundry-deck-heavy - B2: run a heavy local command through a host-sized slot lock.

  foundry-deck-heavy [--slots N] [--timeout SECONDS] [--lock-dir DIR] -- <command> [args...]

Heavy commands (test suites, type checks, builds, dependency installs, container stacks, infra
plans) go through this wrapper so only `heavy_slots` of them run at once on the host. The slot is
an flock on a lock file, so the kernel drops it when the wrapper exits by ANY path, SIGKILL
included. The lock descriptor is close-on-exec: the wrapped command never inherits it.

Slots: --slots, else the policy `deck.heavy_slots` (`auto` is sized from measured CPU and memory
by foundry_deck_resources.py). Lock files live under <git common dir>/foundry-deck-heavy, else
$XDG_RUNTIME_DIR/foundry-deck-heavy, else the system temp dir.

Waiting is bounded by --timeout (default 600 s). The wait is reported on stderr as
`deck-heavy: slot N/M acquired, waited S.SSs`. A timeout reports `timed out` and exits 75
without running the command. Otherwise the exit status is the wrapped command's (a command
ended by signal N exits 128+N).
"""
import argparse
import fcntl
import importlib.util
import os
import signal
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
EX_TEMPFAIL = 75
POLL_S = 0.1


def lock_dir_default():
    try:
        r = subprocess.run(["git", "rev-parse", "--git-common-dir"], capture_output=True, text=True, timeout=10, check=False)
        common = r.stdout.strip()
        if r.returncode == 0 and common:
            return os.path.join(os.path.abspath(common), "foundry-deck-heavy")
    except (OSError, subprocess.SubprocessError):
        pass
    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    return os.path.join(base, "foundry-deck-heavy")


def slots_from_policy():
    spec = importlib.util.spec_from_file_location("foundry_deck_resources", os.path.join(HERE, "foundry_deck_resources.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return int(mod.evaluate()["heavy_slots"])


def try_acquire(lock_dir, slots):
    for n in range(1, slots + 1):
        fd = os.open(os.path.join(lock_dir, "slot-%d.lock" % n), os.O_CREAT | os.O_RDWR, 0o644)  # non-inheritable
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return n, fd
        except OSError:
            os.close(fd)
    return None, None


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if "--" not in argv:
        print("deck-heavy: usage: foundry-deck-heavy [--slots N] [--timeout S] [--lock-dir D] -- <command>", file=sys.stderr)
        return 2
    i = argv.index("--")
    ap = argparse.ArgumentParser(prog="foundry-deck-heavy")
    ap.add_argument("--slots", type=int)
    ap.add_argument("--timeout", type=float, default=600.0)
    ap.add_argument("--lock-dir")
    a = ap.parse_args(argv[:i])
    cmd = argv[i + 1:]
    if not cmd:
        print("deck-heavy: no command after --", file=sys.stderr)
        return 2
    slots = a.slots if a.slots is not None else slots_from_policy()
    if slots < 1:
        print("deck-heavy: --slots must be at least 1", file=sys.stderr)
        return 2
    lock_dir = a.lock_dir or lock_dir_default()
    os.makedirs(lock_dir, exist_ok=True)

    child = {"p": None}

    def on_signal(signum, _frame):
        if child["p"] is not None and child["p"].poll() is None:
            child["p"].send_signal(signum)
        else:
            raise SystemExit(128 + signum)

    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, on_signal)

    start = time.monotonic()
    fd = None
    try:
        while True:
            n, fd = try_acquire(lock_dir, slots)
            if fd is not None:
                break
            if time.monotonic() - start >= a.timeout:
                print("deck-heavy: timed out after %.2fs waiting for one of %d slots; command not run"
                      % (time.monotonic() - start, slots), file=sys.stderr)
                return EX_TEMPFAIL
            time.sleep(POLL_S)
        print("deck-heavy: slot %d/%d acquired, waited %.2fs" % (n, slots, time.monotonic() - start), file=sys.stderr, flush=True)
        try:
            child["p"] = subprocess.Popen(cmd)
        except OSError as e:
            print("deck-heavy: cannot run %r: %s" % (cmd[0], e), file=sys.stderr)
            return 127
        rc = child["p"].wait()
        return 128 - rc if rc < 0 else rc
    finally:
        if fd is not None:
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            finally:
                os.close(fd)


if __name__ == "__main__":
    sys.exit(main())
